# Optional for the local dashboard. Leave empty to inspect the UI without alerts.
# A non-empty token automatically starts monitoring and Telegram update polling.
TELEGRAM_BOT_TOKEN=""

# Initial defaults; saved data/config.json takes precedence after first launch.
TOKEN_ADDRESS="0x5EE54869Ecd5E752C31aF095187326D4A4D50e1c"
# Implemented RPC networks: bsc or ethereum.
CHAIN="bsc"

# The server reads process.env; it does not load .env automatically.
# Development (Node 22+): node --env-file=.env --run dev
